# Environment Configuration
# Copy this file to .env and fill in your values

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true
ENVIRONMENT=development

# MongoDB Connection
# For local development: mongodb://localhost:27017/civic_connect
# For MongoDB Atlas: mongodb+srv://user:password@cluster.mongodb.net/civic_connect
MONGODB_URI=mongodb://localhost:27017/civic_connect
DATABASE_NAME=civic_connect

# JWT Settings
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production-make-it-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin Passkeys (keep these secret!)
SUPER_ADMIN_PASSKEY=ykls_764
DEPARTMENT_PASSKEY_PUBLIC_WORKS=ljn_9871
DEPARTMENT_PASSKEY_HEALTH=ljn_9872
DEPARTMENT_PASSKEY_EDUCATION=ljn_9873
DEPARTMENT_PASSKEY_ENVIRONMENT=ljn_9874
DEPARTMENT_PASSKEY_TRANSPORT=ljn_9875
DEPARTMENT_PASSKEY_WATER_SUPPLY=ljn_9876
DEPARTMENT_PASSKEY_ELECTRICITY=ljn_9877
DEPARTMENT_PASSKEY_HOUSING=ljn_9878

# Google Gemini AI API Key (for AI assistant Casey)
GEMINI_API_KEY=your-gemini-api-key

# File Upload Settings
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Optional: Email Service (SendGrid)
# SENDGRID_API_KEY=your-sendgrid-api-key
# FROM_EMAIL=noreply@civic-connect.com
